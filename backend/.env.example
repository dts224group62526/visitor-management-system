# Copy this file to .env and fill in your values

# PostgreSQL — Railway auto-injects DATABASE_URL when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@localhost:5432/visitor_management

# Session secret — use a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Port — Railway sets PORT automatically
PORT=4000

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development
